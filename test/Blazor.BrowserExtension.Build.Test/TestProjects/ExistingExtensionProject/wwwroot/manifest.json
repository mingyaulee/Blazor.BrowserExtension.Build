{
  "manifest_version": 3,
  "name": "ExistingExtensionProject",
  "description": "A browser extension for integration test of Blazor.BrowserExtension.Build BuildIntegrationTest",
  "version": "1.0",
  "background": {
    "service_worker": "BackgroundWorker.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "framework/*",
        "content/*"
      ],
      "matches": [ "<all_urls>" ]
    }
  ]
}